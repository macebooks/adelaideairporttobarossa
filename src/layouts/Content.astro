---
/*
  Content.astro — shared layout for the supporting content pages (comparison,
  logistics, groups, township pages). Carries the index page's palette and type,
  and adds what those pages need that /privacy and /terms do not: tables, callouts,
  CTA buttons and an FAQ block.

  Wider than Legal.astro because these pages lead on tables.

  Props: title, description, slug, h1, eyebrow, lead, schemas (array, optional)
*/
const {
  title,
  description,
  slug,
  h1,
  eyebrow,
  lead,
  schemas = [],
} = Astro.props;

const site = 'https://adelaideairporttobarossa.com.au';
const url = `${site}/${slug}`;
const ogImage = `${site}/assets/img/og-image.jpg`;
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="theme-color" content="#F3ECDD">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Adelaide Airport to Barossa">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={ogImage}>
<meta property="og:locale" content="en_AU">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

{schemas.map((s) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
))}

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  :root {
    --ink:#241E1B; --bone:#F3ECDD; --vine:#2F5233; --wine:#7A2C3B; --gold:#E8A33D;
    --sky:#6795AF; --docket:#FBF7EE;
    --pad: clamp(1.1rem, 4vw, 2rem);
  }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin:0; background:var(--bone); color:var(--ink);
    font-family:"Hanken Grotesk", system-ui, sans-serif;
    font-size:clamp(1rem,1.2vw,1.08rem); line-height:1.65; overflow-x:hidden;
  }
  .wrap { max-width:880px; margin:0 auto; padding-inline:var(--pad); }
  a { color:var(--wine); }
  a:focus-visible, .btn:focus-visible { outline:3px solid var(--ink); outline-offset:3px; }
  h1,h2,h3 { font-family:"Bricolage Grotesque","Hanken Grotesk",sans-serif; font-weight:800; line-height:1.08; letter-spacing:-0.01em; }
  h1 { font-size:clamp(2rem,5.2vw,3.1rem); margin:0 0 .5em; }
  h2 { font-size:clamp(1.35rem,3vw,1.9rem); margin:2.8rem 0 .7rem; }
  h3 { font-size:clamp(1.08rem,2vw,1.25rem); font-weight:700; margin:1.8rem 0 .5rem; }
  p, li { margin:0 0 1rem; }
  ul, ol { padding-left:1.2rem; }
  strong { font-weight:600; }
  .skip { position:absolute; left:-9999px; }
  .skip:focus { left:var(--pad); top:.6rem; position:fixed; background:var(--ink); color:var(--bone); padding:.6rem 1rem; border-radius:10px; z-index:99; }

  .head { background:var(--ink); color:var(--bone); padding-block:1rem; }
  .head a { color:var(--bone); text-decoration:none; font-family:"Space Mono",ui-monospace,monospace; font-size:.78rem; letter-spacing:.14em; text-transform:uppercase; }
  .head a:hover { text-decoration:underline; }

  main { padding-block: clamp(2.5rem,7vw,4.5rem); }
  .eyebrow { font-family:"Space Mono",ui-monospace,monospace; font-size:.74rem; letter-spacing:.16em; text-transform:uppercase; color:var(--wine); margin:0 0 .8rem; }
  .lead { font-size:clamp(1.08rem,1.9vw,1.3rem); line-height:1.5; margin-bottom:1.6rem; }

  /* Tables scroll inside their own container; the page never scrolls sideways. */
  .tw { overflow-x:auto; margin:1.4rem 0 1.8rem; border:2px solid rgba(36,30,27,.14); border-radius:14px; background:var(--docket); }
  table { border-collapse:collapse; width:100%; min-width:460px; font-size:.95rem; }
  /* Narrow tables (three short columns) fit a phone without the scroll box. */
  table.fit { min-width:0; }
  th, td { text-align:left; padding:.7rem .9rem; border-bottom:1px solid rgba(36,30,27,.12); vertical-align:top; }
  th { font-family:"Space Mono",ui-monospace,monospace; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; background:rgba(36,30,27,.05); }
  tr:last-child td { border-bottom:none; }

  .note { background:var(--docket); border:2px solid rgba(36,30,27,.14); border-radius:14px; padding:1rem 1.2rem; margin:1.6rem 0; }
  .note :last-child { margin-bottom:0; }
  .pull { background:var(--vine); color:var(--bone); border-radius:14px; padding:1.4rem 1.5rem; margin:1.8rem 0; }
  .pull p { font-family:"Bricolage Grotesque","Hanken Grotesk",sans-serif; font-weight:800; font-size:clamp(1.15rem,2.4vw,1.5rem); line-height:1.2; margin:0 0 .4rem; }
  .pull p:last-child { margin-bottom:0; }

  .btn { display:inline-block; background:var(--wine); color:var(--bone); text-decoration:none; font-weight:600; padding:.85rem 1.4rem; border-radius:999px; margin:.4rem 0 1.4rem; }
  .btn:hover { background:var(--ink); }

  .faq h3 { margin-top:1.6rem; }
  .faq p { margin-bottom:1.2rem; }

  footer { background:var(--ink); color:var(--bone); padding-block:2rem; font-size:.88rem; }
  footer a { color:var(--gold); }
  footer .cols { display:flex; flex-wrap:wrap; gap:.5rem 1.2rem; }

  @media (prefers-reduced-motion: reduce) { *,*::before,*::after { animation-duration:.01ms !important; transition-duration:.01ms !important; } }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="head">
  <div class="wrap"><a href="/">&larr; adelaideairporttobarossa.com.au</a></div>
</header>
<main id="main">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</main>
<footer>
  <div class="wrap">
    <p class="cols" style="margin:0 0 .6rem">
      <a href="/">Home</a>
      <a href="/how-to-get-from-adelaide-airport-to-barossa-valley">Transport options</a>
      <a href="/adelaide-airport-to-barossa-valley-distance-and-transfer-times">Distances &amp; logistics</a>
      <a href="/group-transfers-adelaide-airport-barossa-valley">Group transfers</a>
      <a href="/barossa-to-adelaide-airport-transfer">Barossa to the airport</a>
    </p>
    <p style="margin:0 0 .6rem">Email <a href="mailto:bookings@adelaideairporttobarossa.com.au">bookings@adelaideairporttobarossa.com.au</a></p>
    <p style="margin:0">&copy; 2026 adelaideairporttobarossa.com.au &middot;
      <a href="/privacy">Privacy</a> &middot; <a href="/terms">Terms</a></p>
  </div>
</footer>
</body>
</html>
